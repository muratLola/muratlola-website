---
import Base from '../../layouts/Base.astro';
import Social from '../../components/Social.astro';
---
<Base
  veil={true}
  title="muratLola — Football Kit & Brand Identity Designer"
  description="muratLola (Murat Ogur) — art director designing football kits, brand identities and visual systems for clubs and brands."
>
  <section class="hero">
    <div class="hero__type">
      <h1>
        <span class="ln"><span data-split>Murat</span></span>
        <span class="ln"><span data-split class="is-accent">Ogur</span></span>
      </h1>
    </div>

    <div class="hero__rule" aria-hidden="true"></div>

    <div class="hero__meta">
      <p>
        Visual communication designer &amp; art director. <b>Football kit design</b>,
        brand identity and visual strategy for clubs and brands.
      </p>
      <div class="hero__tags">
        <span>Kit Design</span>
        <span>Brand Identity</span>
        <span>Art Direction</span>
      </div>
    </div>
  </section>

  <section class="section">
    <p class="statement" data-reveal>
      I bring a <em>strategic</em> language to sport.
    </p>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="head">
      <div>
        <div class="eyebrow"><i></i><span>Selected Work</span></div>
        <h2 class="h2" data-split-chars>Archive</h2>
      </div>
      <a class="btn" href="/en/projects"><span>All work</span><i>→</i></a>
    </div>
    <div class="kit-grid" id="home-grid"></div>
  </section>

  <section class="section about">
    <div class="about__frame" data-reveal>
      <img src="/img/murat-ogur.jpg" alt="Murat Ogur — muratLola" />
    </div>
    <div class="about__body" data-reveal>
      <h2 class="h2 h2--sm" style="margin-bottom:1.4rem;">A kit's colour is not a preference. It is a decision.</h2>
      <p>I design football kits, brand identities and art direction for clubs and brands. Every project starts from a story: if colour, cut and texture do not tell that story, they are decoration.</p>
      <p>I run the process end to end — from the first idea to 3D simulation and the final presentation frames.</p>
      <a class="btn" href="/en/about"><span>More</span><i>→</i></a>
    </div>
  </section>

  <section class="section">
    <div class="eyebrow"><i></i><span>Contact</span></div>
    <a class="contact__big" href="mailto:muratlola0526@gmail.com" data-cur="Write">
      <span class="ln"><span data-split-chars>Let's work</span></span>
      <span class="ln"><span data-split-chars>together</span></span>
    </a>
    <div class="contact__row" data-reveal>
      <a href="mailto:muratlola0526@gmail.com">muratlola0526@gmail.com</a>
      <a href="tel:+905418099987">+90 541 809 9987</a>
    </div>
    <Social class="social social--row" />
  </section>
</Base>

<script>
  import { getProjects } from '../../lib/store.js';
  import { renderKits } from '../../scripts/kits.js';
  getProjects().then(list => renderKits(document.getElementById('home-grid'), list.slice(0, 4),
    { empty: 'No work added yet.', base: '/en/project' }));
</script>
