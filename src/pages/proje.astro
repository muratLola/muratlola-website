---
/* Eski adres: /proje?p=slug
   Artık proje detayı /proje/slug altında build sırasında üretiliyor.
   Bu sayfa yalnızca eskiden paylaşılmış linkleri kırmamak için duruyor —
   sorgu parametresini alır ve yeni adrese aktarır. Arama motoruna
   kapalı, çünkü içeriğin kendisi burada değil. */
import Base from '../layouts/Base.astro';
---
<Base title="Yönlendiriliyor — muratLola" noindex={true}>
  <section class="section" style="padding-top:12rem;">
    <p class="label" id="msg">Yönlendiriliyor…</p>
    <a class="btn" href="/projeler" style="margin-top:2rem;"><i>←</i><span>Projeler</span></a>
  </section>
</Base>

<script is:inline>
  (function () {
    var slug = new URLSearchParams(location.search).get('p');
    if (slug) {
      location.replace('/proje/' + encodeURIComponent(slug));
    } else {
      location.replace('/projeler');
    }
  })();
</script>
