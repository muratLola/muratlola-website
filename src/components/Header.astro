---
import { T, dilBul, digerDil } from '../i18n.js';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const lang = dilBul(Astro.url.pathname);
const t = T[lang];
const diger = digerDil(Astro.url.pathname);

const active = (h) => path === h || path.startsWith(h + '/');
---
<header class="hdr" id="hdr">
  <a class="brand" href={lang === 'en' ? '/en/' : '/'}><span class="brand__name">muratLola</span></a>

  <nav class="nav" id="nav">
    {t.nav.map(l => (
      <a href={l.href} aria-current={active(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
    <a href={t.ctaHref} class="nav__cta">{t.cta}</a>
  </nav>

  <div class="hdr__tools">
    <a class="lang" href={diger.href} aria-label={t.dilAria} title={t.dilAria}>{t.dilEtiket}</a>

    <button class="theme" id="theme" aria-label={t.temaAria} title={t.temaAria}>
    <svg class="t-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
    </svg>
    <svg class="t-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4.2"/>
      <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/>
    </svg>
  </button>
    <button class="burger" id="burger" aria-label={t.menuAria} aria-expanded="false"><i></i><i></i></button>
  </div>
</header>
