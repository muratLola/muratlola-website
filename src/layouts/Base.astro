---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { dilBul, digerDil, T } from '../i18n.js';
import Footer from '../components/Footer.astro';

const {
  title = 'muratLola — Görsel İletişim Tasarımcısı & Art Director',
  description = 'muratLola (Murat Ogur) — Görsel İletişim Tasarımcısı & Art Director. Spor kulüpleri ve markalar için forma tasarımı, kurumsal kimlik ve görsel strateji.',
  veil = false,
  // Sayfaya özel paylaşım görseli. Proje sayfaları kendi kapağını geçer;
  // yoksa her link aynı portreyle önizlenir ve paylaşılan şeyin ne olduğu
  // hiçbir yerden anlaşılmaz.
  image = null,
  type = 'website',
  noindex = false,
} = Astro.props;

/* Ölçüm: yalnızca ilgili ortam değişkeni tanımlıysa yüklenir. Hiçbiri
   tanımlı değilse siteden tek bir üçüncü taraf isteği bile çıkmaz.
   İkisi de çerezsiz çalışır, dolayısıyla çerez izni bandı gerekmez.

     PUBLIC_CF_BEACON_TOKEN    Cloudflare Web Analytics — ücretsiz, sınırsız
     PUBLIC_PLAUSIBLE_DOMAIN   Plausible — ücretli, daha zengin panel

   Birini seç; ikisini birden açmanın anlamı yok. */
const cfBeacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const plausible = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;

const lang = dilBul(Astro.url.pathname);
const diger = digerDil(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site);
/* hreflang: aynı içeriğin diğer dildeki adresi. Bunu vermezsen Google iki
   sayfayı birbirinin kopyası sanıp birini eler. */
const altTr = new URL(diger.lang === 'tr' ? diger.href : Astro.url.pathname, Astro.site).href;
const altEn = new URL(diger.lang === 'en' ? diger.href : Astro.url.pathname, Astro.site).href;
const ogImage = image
  ? (/^https?:\/\//.test(image) ? image : new URL(image, Astro.site).href)
  : new URL('/img/murat-ogur.jpg', Astro.site).href;
---
<!DOCTYPE html>
<html lang={T[lang].htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#FBFAF8" />
  <link rel="alternate" hreflang="tr" href={altTr} />
  <link rel="alternate" hreflang="en" href={altEn} />
  <link rel="alternate" hreflang="x-default" href={altTr} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <meta property="og:site_name" content="muratLola" />
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'tr_TR'} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content={type} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  {cfBeacon && (
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js"
            data-cf-beacon={`{"token": "${cfBeacon}"}`}></script>
  )}
  {!cfBeacon && plausible && (
    <script is:inline defer data-domain={plausible} src="https://plausible.io/js/script.js"></script>
  )}
  <!-- Tema, sayfa boyanmadan ÖNCE uygulanmalı. Bundle'a alınırsa geç
       çalışır ve karanlık modda ilk kare beyaz parlar (FOUC).
       is:inline = Astro dokunmasın, olduğu gibi head'e gömülsün. -->
  <script is:inline>
    (function () {
      try {
        var kayit = localStorage.getItem('ml-theme');
        var koyu = kayit ? kayit === 'dark'
                         : matchMedia('(prefers-color-scheme: dark)').matches;
        if (koyu) document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) { /* localStorage kapalıysa aydınlık kalsın */ }
    })();
  </script>
</head>
<body>

  {veil && (
    <div class="veil" id="veil">
      <div class="veil__word"><span>muratLola</span></div>
      <div class="veil__line"><i></i></div>
    </div>
  )}

  <Header />
  <main><slot /></main>
  <Footer />

  <script>
    import '../scripts/app.js';
  </script>
</body>
</html>
